diff --git a/company/infra/terraform/s3.tf b/company/infra/terraform/s3.tf
index 65e2bf5..d20e268 100644
--- a/company/infra/terraform/s3.tf
+++ b/company/infra/terraform/s3.tf
@@ -27,6 +27,16 @@ resource "aws_s3_bucket" "recon_exports" {
   bucket = "ledgerline-recon-exports"
 }
 
+resource "aws_s3_bucket_server_side_encryption_configuration" "recon_exports" {
+  bucket = aws_s3_bucket.recon_exports.id
+  rule {
+    apply_server_side_encryption_by_default {
+      sse_algorithm     = "aws:kms"
+      kms_master_key_id = aws_kms_key.data.arn
+    }
+  }
+}
+
 resource "aws_s3_bucket_public_access_block" "recon_exports" {
   bucket                  = aws_s3_bucket.recon_exports.id
   block_public_acls       = true
